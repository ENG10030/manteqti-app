const createAmenities = (items: string[]): Amenity[] => {
  const iconMap: Record<string, React.ReactNode> = {
    مواقف: <Car className="size-4" />,
    جيم: <Dumbbell className="size-4" />,
    "واي فاي": <Wifi className="size-4" />,
    أمن: <Shield className="size-4" />,
    حوض: <Waves className="size-4" />,
    "حديقة": <TreePine className="size-4" />,
    مولد: <Zap className="size-4" />,
    أسانسير: <Layers className="size-4" />,
  };
  return items.map((label) => ({
    icon: iconMap[label] || <Check className="size-4" />,
    label,
  }));
};

