/* ==========================================================================
   SECTION 3: Utility Functions
   ========================================================================== */

const formatPrice = (price: number, type: ApartmentType): string => {
  if (type === "إيجار") {
    return `${price.toLocaleString("ar-EG")} ج.م/شهر`;
  }
  return `${price.toLocaleString("ar-EG")} ج.م`;
};

const formatArea = (area: number): string => {
  return `${area} م²`;
};

const getFloorLabel = (floor: number, total: number): string => {
  if (floor === total) return `${floor} (أخير)`;
  return `${floor} من ${total}`;
};

/* ==========================================================================
   SECTION 4: Theme Wrapper Component
   ========================================================================== */

function ManteqtiThemeWrapper({ children }: { children: React.ReactNode }) {
  return (
    <ThemeProvider attribute="class" defaultTheme="light" enableSystem>
      {children}
    </ThemeProvider>
  );
}

/* ==========================================================================
   SECTION 5: Header Component (شريط العنوان)
   ========================================================================== */

function Header({
  favoritesCount,
  onSelectCompare,
  selectedCount,
  onOpenFavorites,
}: {
  favoritesCount: number;
  onSelectCompare: () => void;
  selectedCount: number;
  onOpenFavorites: () => void;
}) {
  return (
    <header className="sticky top-0 z-40 w-full border-b border-border/40 bg-background/80 backdrop-blur-xl">
      <div className="mx-auto flex h-16 max-w-7xl items-center justify-between px-4 sm:px-6">
        {/* Brand */}
        <div className="flex items-center gap-3">
          <div className="flex size-9 items-center justify-center rounded-xl bg-gradient-to-br from-emerald-500 to-teal-600 shadow-lg shadow-emerald-500/20">
            <Building2 className="size-5 text-white" />
          </div>
          <div className="flex flex-col">
            <h1 className="text-lg font-bold leading-tight tracking-tight">
              منطقتي
            </h1>
            <span className="text-[10px] font-medium text-muted-foreground leading-none">
              Manteqti
            </span>
          </div>
        </div>

        {/* Actions */}
        <div className="flex items-center gap-2 sm:gap-3">
          {/* Compare Button */}
          <AnimatePresence>
            {selectedCount >= 2 && (
              <motion.div
                initial={{ scale: 0, opacity: 0 }}
                animate={{ scale: 1, opacity: 1 }}
                exit={{ scale: 0, opacity: 0 }}
                transition={{ type: "spring", stiffness: 500, damping: 30 }}
              >
                <Button
                  onClick={onSelectCompare}
                  className="gap-2 bg-gradient-to-l from-emerald-600 to-teal-600 text-white shadow-lg shadow-emerald-500/20 hover:from-emerald-700 hover:to-teal-700"
                  size="sm"
                >
                  <GitCompareArrows className="size-4" />
                  <span className="hidden sm:inline">مقارنة</span>
                  <Badge
                    variant="secondary"
                    className="h-5 min-w-5 bg-white/20 text-white text-[10px]"
                  >
                    {selectedCount}
                  </Badge>
                </Button>
              </motion.div>
            )}
          </AnimatePresence>

          {/* Favorites Button */}
          <Button
            variant="outline"
            size="sm"
            onClick={onOpenFavorites}
            className="relative gap-2"
          >
            <Heart className="size-4 text-red-500" />
            <span className="hidden sm:inline">المفضلات</span>
            {favoritesCount > 0 && (
              <motion.span
                key={favoritesCount}
                initial={{ scale: 0 }}
                animate={{ scale: 1 }}
                className="absolute -top-1.5 -left-1.5 flex size-5 items-center justify-center rounded-full bg-red-500 text-[10px] font-bold text-white shadow-sm"
              >
                {favoritesCount}
              </motion.span>
            )}
          </Button>

          {/* Dark Mode Toggle */}
          <DarkModeToggle />
        </div>
      </div>
    </header>
  );
}

/* ---------- Dark Mode Toggle ---------- */
function DarkModeToggle() {
  const [mounted, setMounted] = React.useState(false);
  // Simple dark mode toggle by toggling class on html element
  const [isDark, setIsDark] = React.useState(false);

  React.useEffect(() => {
    setMounted(true);
    setIsDark(document.documentElement.classList.contains("dark"));
  }, []);

  const toggle = () => {
    const next = !isDark;
    setIsDark(next);
    document.documentElement.classList.toggle("dark", next);
  };

  if (!mounted) return <div className="size-8" />;

  return (
    <Button
      variant="ghost"
      size="icon"
      onClick={toggle}
      className="size-8"
    >
      <motion.div
        key={isDark ? "dark" : "light"}
        initial={{ rotate: -90, opacity: 0 }}
        animate={{ rotate: 0, opacity: 1 }}
        transition={{ duration: 0.3 }}
      >
        {isDark ? (
          <Zap className="size-4 text-amber-400" />
        ) : (
          <SunIcon className="size-4 text-amber-500" />
        )}
      </motion.div>
    </Button>
  );
}

function SunIcon({ className }: { className?: string }) {
  return (
    <svg
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      strokeWidth="2"
      strokeLinecap="round"
      strokeLinejoin="round"
      className={className}
    >
      <circle cx="12" cy="12" r="4" />
      <path d="M12 2v2" />
      <path d="M12 20v2" />
      <path d="m4.93 4.93 1.41 1.41" />
      <path d="m17.66 17.66 1.41 1.41" />
      <path d="M2 12h2" />
      <path d="M20 12h2" />
      <path d="m6.34 17.66-1.41 1.41" />
      <path d="m19.07 4.93-1.41 1.41" />
    </svg>
  );
}

/* ==========================================================================
   SECTION 6: Apartment Card Component (بطاقة الشقة)
   ========================================================================== */

function ApartmentCard({
  apartment,
  isFavorite,
  isSelected,
  onToggleFavorite,
  onToggleSelect,
}: {
  apartment: Apartment;
  isFavorite: boolean;
  isSelected: boolean;
  onToggleFavorite: () => void;
  onToggleSelect: () => void;
}) {
  const [imgIndex, setImgIndex] = useState(0);

  return (
    <motion.div
      layout
      initial={{ opacity: 0, y: 20 }}
      animate={{ opacity: 1, y: 0 }}
      exit={{ opacity: 0, y: -20 }}
      transition={{ duration: 0.3 }}
    >
      <Card
        className={`group overflow-hidden border-2 transition-all duration-300 hover:shadow-xl hover:-translate-y-1 ${
          isSelected
            ? "border-emerald-500 shadow-lg shadow-emerald-500/10"
            : "border-border/50 hover:border-emerald-300"
        }`}
      >
        {/* Image Area */}
        <div className="relative h-48 overflow-hidden sm:h-56">
          <div
            className="absolute inset-0 transition-transform duration-500 group-hover:scale-105"
            style={{ background: apartment.gradient }}
          >
            {/* Building icon overlay */}
            <div className="absolute inset-0 flex items-center justify-center opacity-20">
              <Building2 className="size-32 text-white" />
            </div>
            {/* Gradient overlay */}
            <div className="absolute inset-0 bg-gradient-to-t from-black/50 via-transparent to-transparent" />
          </div>

          {/* Top badges */}
          <div className="absolute top-3 right-3 flex items-center gap-2">
            <Badge
              className={`text-[11px] font-semibold shadow-sm ${
                apartment.type === "بيع"
                  ? "bg-amber-500/90 text-white hover:bg-amber-500"
                  : "bg-emerald-500/90 text-white hover:bg-emerald-500"
              }`}
            >
              {apartment.type === "بيع" ? "للبيع" : "للإيجار"}
            </Badge>
            {apartment.rating >= 4.5 && (
              <Badge className="gap-1 bg-amber-500/90 text-white text-[11px] shadow-sm hover:bg-amber-500">
                <Star className="size-3 fill-current" />
                {apartment.rating}
              </Badge>
            )}
          </div>

          {/* Favorite button */}
          <motion.button
            whileTap={{ scale: 0.85 }}
            onClick={(e) => {
              e.stopPropagation();
              onToggleFavorite();
            }}
            className="absolute top-3 left-3 flex size-9 items-center justify-center rounded-full bg-white/90 shadow-md backdrop-blur-sm transition-colors hover:bg-white"
          >
            <motion.div
              animate={
                isFavorite
                  ? { scale: [1, 1.3, 1], rotate: [0, -10, 10, 0] }
                  : { scale: 1 }
              }
              transition={{ duration: 0.4 }}
            >
              <Heart
                className={`size-5 transition-colors ${
                  isFavorite
                    ? "fill-red-500 text-red-500"
                    : "text-gray-400"
                }`}
              />
            </motion.div>
          </motion.button>

          {/* Price */}
          <div className="absolute bottom-3 right-3">
            <div className="rounded-lg bg-white/95 px-3 py-1.5 shadow-md backdrop-blur-sm">
              <span className="text-sm font-bold text-gray-900">
                {formatPrice(apartment.price, apartment.type)}
              </span>
            </div>
          </div>

          {/* Selection indicator */}
          {isFavorite && (
            <div className="absolute bottom-3 left-3">
              <motion.button
                whileTap={{ scale: 0.85 }}
                onClick={(e) => {
                  e.stopPropagation();
                  onToggleSelect();
                }}
                className={`flex items-center gap-1.5 rounded-lg px-2.5 py-1.5 text-xs font-semibold shadow-md backdrop-blur-sm transition-all ${
                  isSelected
                    ? "bg-emerald-500 text-white"
                    : "bg-white/90 text-gray-700 hover:bg-emerald-50"
                }`}
              >
                <Checkbox
                  checked={isSelected}
                  onCheckedChange={onToggleSelect}
                  className="hidden"
                />
                <div
                  className={`flex size-4 items-center justify-center rounded border ${
                    isSelected
                      ? "border-white bg-white/20"
                      : "border-gray-300"
                  }`}
                >
                  {isSelected && <Check className="size-3 text-white" />}
                </div>
                <span>{isSelected ? "محدد للمقارنة" : "اختر للمقارنة"}</span>
              </motion.button>
            </div>
          )}
        </div>

        {/* Content */}
        <CardContent className="p-4">
          <h3 className="mb-2 line-clamp-1 text-sm font-bold leading-tight text-foreground sm:text-base">
            {apartment.title}
          </h3>

          {/* Location */}
          <div className="mb-3 flex items-center gap-1.5 text-xs text-muted-foreground">
            <MapPin className="size-3.5 shrink-0 text-emerald-500" />
            <span className="line-clamp-1">
              {apartment.location}، {apartment.city}
            </span>
          </div>

          {/* Stats Grid */}
          <div className="mb-3 grid grid-cols-4 gap-2">
            <div className="flex flex-col items-center gap-0.5 rounded-lg bg-muted/50 p-2">
              <Maximize2 className="size-3.5 text-emerald-600" />
              <span className="text-[11px] font-semibold text-foreground">
                {apartment.area}
              </span>
              <span className="text-[9px] text-muted-foreground">م²</span>
            </div>
            <div className="flex flex-col items-center gap-0.5 rounded-lg bg-muted/50 p-2">
              <BedDouble className="size-3.5 text-blue-600" />
              <span className="text-[11px] font-semibold text-foreground">
                {apartment.bedrooms}
              </span>
              <span className="text-[9px] text-muted-foreground">غرف</span>
            </div>
            <div className="flex flex-col items-center gap-0.5 rounded-lg bg-muted/50 p-2">
              <Bath className="size-3.5 text-violet-600" />
              <span className="text-[11px] font-semibold text-foreground">
                {apartment.bathrooms}
              </span>
              <span className="text-[9px] text-muted-foreground">حمام</span>
            </div>
            <div className="flex flex-col items-center gap-0.5 rounded-lg bg-muted/50 p-2">
              <Layers className="size-3.5 text-amber-600" />
              <span className="text-[11px] font-semibold text-foreground">
                {apartment.floor}
              </span>
              <span className="text-[9px] text-muted-foreground">دور</span>
            </div>
          </div>

          {/* Amenities preview */}
          <div className="mb-3 flex flex-wrap gap-1.5">
            {apartment.amenities.slice(0, 4).map((amenity) => (
              <span
                key={amenity.label}
                className="inline-flex items-center gap-1 rounded-full bg-muted/70 px-2 py-0.5 text-[10px] text-muted-foreground"
              >
                {amenity.icon}
                {amenity.label}
              </span>
            ))}
            {apartment.amenities.length > 4 && (
              <span className="inline-flex items-center rounded-full bg-muted/70 px-2 py-0.5 text-[10px] text-muted-foreground">
                +{apartment.amenities.length - 4}
              </span>
            )}
          </div>

          {/* Footer */}
          <div className="flex items-center justify-between border-t border-border/50 pt-3">
            <div className="flex items-center gap-3 text-[11px] text-muted-foreground">
              <span className="flex items-center gap-1">
                <Eye className="size-3" />
                {apartment.viewsCount}
              </span>
              <span className="flex items-center gap-1">
                <Scale className="size-3" />
                {apartment.furnishing}
              </span>
            </div>
            <Badge variant="outline" className="text-[10px]">
              {apartment.status}
            </Badge>
          </div>
        </CardContent>
      </Card>
    </motion.div>
  );
}

/* ==========================================================================
   SECTION 7: Favorites Sheet Component (لوحة المفضلات)
   ========================================================================== */

function FavoritesPanel({
  favorites,
  selectedIds,
  onToggleSelect,
  onRemove,
  onOpenCompare,
}: {
  favorites: Apartment[];
  selectedIds: Set<string>;
  onToggleSelect: (id: string) => void;
  onRemove: (id: string) => void;
  onOpenCompare: () => void;
}) {
  return (
    <div className="flex h-full flex-col">
      <SheetHeader className="pb-2">
        <SheetTitle className="flex items-center gap-2 text-lg">
          <Heart className="size-5 fill-red-500 text-red-500" />
          المفضلات
          <Badge variant="secondary" className="text-xs">
            {favorites.length}
          </Badge>
        </SheetTitle>
        <SheetDescription>
          اختر الشقق للمقارنة (حد أقصى ٤ شقق)
        </SheetDescription>
      </SheetHeader>

      <div className="border-t border-border/50 px-4 py-2">
        <div className="flex items-center justify-between text-xs text-muted-foreground">
          <span>
            تم اختيار {selectedIds.size} من {favorites.length}
          </span>
          <Button
            variant="ghost"
            size="sm"
            className="h-6 text-[11px]"
            onClick={() => {
              if (selectedIds.size > 0) {
                favorites.forEach((f) => onToggleSelect(f.id));
              } else {
                favorites.slice(0, 4).forEach((f) => onToggleSelect(f.id));
              }
            }}
          >
            {selectedIds.size > 0 ? "إلغاء الكل" : "اختر الكل"}
          </Button>
        </div>
      </div>

      {favorites.length === 0 ? (
        <div className="flex flex-1 flex-col items-center justify-center gap-3 px-4 py-12 text-center">
          <div className="flex size-16 items-center justify-center rounded-full bg-muted">
            <Heart className="size-8 text-muted-foreground" />
          </div>
          <p className="text-sm text-muted-foreground">
            لا توجد شقق في المفضلات
          </p>
          <p className="text-xs text-muted-foreground">
            اضغط على أيقونة القلب لإضافة شقة
          </p>
        </div>
      ) : (
        <>
          <ScrollArea className="flex-1 px-4">
            <div className="space-y-3 py-3">
              <AnimatePresence mode="popLayout">
                {favorites.map((apt) => (
                  <motion.div
                    key={apt.id}
                    layout
                    initial={{ opacity: 0, x: -20 }}
                    animate={{ opacity: 1, x: 0 }}
                    exit={{ opacity: 0, x: 20, height: 0, marginBottom: 0 }}
                    transition={{ duration: 0.25 }}
                  >
                    <div
                      className={`rounded-xl border-2 p-3 transition-all ${
                        selectedIds.has(apt.id)
                          ? "border-emerald-500 bg-emerald-50/50 dark:bg-emerald-950/20"
                          : "border-border/50"
                      }`}
                    >
                      <div className="flex gap-3">
                        {/* Thumbnail */}
                        <div
                          className="relative h-20 w-20 shrink-0 overflow-hidden rounded-lg sm:h-24 sm:w-24"
                          style={{ background: apt.gradient }}
                        >
                          <div className="absolute inset-0 flex items-center justify-center opacity-30">
                            <Building2 className="size-8 text-white" />
                          </div>
                        </div>

                        {/* Info */}
                        <div className="flex flex-1 flex-col justify-between min-w-0">
                          <div>
                            <h4 className="line-clamp-1 text-sm font-bold">
                              {apt.title}
                            </h4>
                            <p className="mt-0.5 flex items-center gap-1 text-[11px] text-muted-foreground">
                              <MapPin className="size-3 shrink-0" />
                              <span className="line-clamp-1">{apt.city}</span>
                            </p>
                          </div>
                          <div className="flex items-center gap-2 text-xs">
                            <span className="font-bold text-emerald-600 dark:text-emerald-400">
                              {formatPrice(apt.price, apt.type)}
                            </span>
                            <span className="text-muted-foreground">·</span>
                            <span className="text-muted-foreground">
                              {apt.area} م²
                            </span>
                          </div>
                        </div>

                        {/* Checkbox + Remove */}
                        <div className="flex flex-col items-center justify-between gap-2">
                          <motion.button
                            whileTap={{ scale: 0.85 }}
                            onClick={() => onRemove(apt.id)}
                            className="flex size-7 items-center justify-center rounded-full text-muted-foreground transition-colors hover:bg-red-50 hover:text-red-500 dark:hover:bg-red-950/30"
                          >
                            <X className="size-4" />
                          </motion.button>
                          <button
                            onClick={() => onToggleSelect(apt.id)}
                            className={`flex size-6 items-center justify-center rounded-md border-2 transition-all ${
                              selectedIds.has(apt.id)
                                ? "border-emerald-500 bg-emerald-500 text-white"
                                : "border-gray-300 hover:border-emerald-400"
                            }`}
                          >
                            {selectedIds.has(apt.id) && (
                              <Check className="size-3.5" />
                            )}
                          </button>
                        </div>
                      </div>
                    </div>
                  </motion.div>
                ))}
              </AnimatePresence>
            </div>
          </ScrollArea>

          {/* Compare Button in Sheet Footer */}
          {selectedIds.size >= 2 && (
            <div className="border-t border-border/50 p-4">
              <Button
                onClick={onOpenCompare}
                className="w-full gap-2 bg-gradient-to-l from-emerald-600 to-teal-600 text-white shadow-lg shadow-emerald-500/20"
              >
                <GitCompareArrows className="size-4" />
                مقارنة {selectedIds.size} شقق
                <ChevronUp className="size-4" />
              </Button>
            </div>
          )}
        </>
      )}
    </div>
  );
}

/* ==========================================================================
   SECTION 8: Comparison Table Component (جدول المقارنة)
   ========================================================================== */

function ComparisonTable({
  apartments,
}: {
  apartments: Apartment[];
}) {
  // Find best values for highlighting
  const bestValues = useMemo(() => {
    if (apartments.length === 0) return {};
    const prices = apartments.map((a) => a.price);
    const areas = apartments.map((a) => a.area);
    const bedrooms = apartments.map((a) => a.bedrooms);
    const bathrooms = apartments.map((a) => a.bathrooms);
    const ratings = apartments.map((a) => a.rating);

    return {
      price: apartments.find((a) => a.price === Math.min(...prices))?.id,
      area: apartments.find((a) => a.area === Math.max(...areas))?.id,
      bedrooms: apartments.find((a) => a.bedrooms === Math.max(...bedrooms))
        ?.id,
      bathrooms: apartments.find(
        (a) => a.bathrooms === Math.max(...bathrooms)
      )?.id,
      rating: apartments.find((a) => a.rating === Math.max(...ratings))?.id,
      amenities: apartments.find(
        (a) => a.amenities.length === Math.max(...apartments.map((x) => x.amenities.length))
      )?.id,
    };
  }, [apartments]);

  const BestBadge = ({ isBest, label }: { isBest: boolean; label: string }) =>
    isBest ? (
      <Badge className="gap-1 border-emerald-200 bg-emerald-50 text-[10px] font-semibold text-emerald-700 dark:border-emerald-800 dark:bg-emerald-950/50 dark:text-emerald-400">
        <Trophy className="size-3" />
        {label}
      </Badge>
    ) : null;

  const rows: {
    icon: React.ReactNode;
    label: string;
    getValue: (apt: Apartment) => React.ReactNode;
    bestKey?: keyof typeof bestValues;
    bestLabel?: string;
  }[] = [
    {
      icon: <Scale className="size-4 text-emerald-600" />,
      label: "السعر",
      getValue: (apt) => (
        <span className="text-sm font-bold">
          {formatPrice(apt.price, apt.type)}
        </span>
      ),
      bestKey: "price",
      bestLabel: "أفضل سعر",
    },
    {
      icon: <Maximize2 className="size-4 text-blue-600" />,
      label: "المساحة",
      getValue: (apt) => (
        <span className="text-sm font-semibold">{formatArea(apt.area)}</span>
      ),
      bestKey: "area",
      bestLabel: "أكبر مساحة",
    },
    {
      icon: <BedDouble className="size-4 text-violet-600" />,
      label: "غرف النوم",
      getValue: (apt) => (
        <span className="text-sm font-semibold">{apt.bedrooms} غرفة</span>
      ),
      bestKey: "bedrooms",
      bestLabel: "أكثر غرف",
    },
    {
      icon: <Bath className="size-4 text-cyan-600" />,
      label: "الحمامات",
      getValue: (apt) => (
        <span className="text-sm font-semibold">{apt.bathrooms} حمام</span>
      ),
      bestKey: "bathrooms",
      bestLabel: "أكثر حمامات",
    },
    {
      icon: <Layers className="size-4 text-amber-600" />,
      label: "الدور",
      getValue: (apt) => (
        <span className="text-sm">{getFloorLabel(apt.floor, apt.totalFloors)}</span>
      ),
    },
    {
      icon: <Building2 className="size-4 text-gray-600" />,
      label: "النوع",
      getValue: (apt) => (
        <Badge
          className={`text-xs ${
            apt.type === "بيع"
              ? "bg-amber-100 text-amber-700 dark:bg-amber-950/50 dark:text-amber-400"
              : "bg-emerald-100 text-emerald-700 dark:bg-emerald-950/50 dark:text-emerald-400"
          }`}
        >
          {apt.type === "بيع" ? "للبيع" : "للإيجار"}
        </Badge>
      ),
    },
    {
      icon: <Shield className="size-4 text-gray-600" />,
      label: "التشطيب",
      getValue: (apt) => (
        <span className="text-sm">{apt.furnishing}</span>
      ),
    },
    {
      icon: <Star className="size-4 text-amber-500" />,
      label: "التقييم",
      getValue: (apt) => (
        <span className="flex items-center gap-1 text-sm font-bold">
          <Star className="size-3.5 fill-amber-400 text-amber-400" />
          {apt.rating}
        </span>
      ),
      bestKey: "rating",
      bestLabel: "أعلى تقييم",
    },
    {
      icon: <MapPin className="size-4 text-red-500" />,
      label: "الموقع",
      getValue: (apt) => (
        <div className="text-sm">
          <p className="font-semibold">{apt.city}</p>
          <p className="text-xs text-muted-foreground">{apt.location}</p>
        </div>
      ),
    },
    {
      icon: <Zap className="size-4 text-gray-600" />,
      label: "المميزات",
      getValue: (apt) => (
        <div className="flex flex-wrap gap-1">
          {apt.amenities.map((a) => (
            <span
              key={a.label}
              className="inline-flex items-center gap-0.5 rounded-full bg-muted px-1.5 py-0.5 text-[10px]"
            >
              {a.icon}
              {a.label}
            </span>
          ))}
        </div>
      ),
      bestKey: "amenities",
      bestLabel: "أكثر مميزات",
    },
    {
      icon: <Info className="size-4 text-gray-600" />,
      label: "الوصف",
      getValue: (apt) => (
        <p className="text-xs leading-relaxed text-muted-foreground">
          {apt.description}
        </p>
      ),
    },
  ];

  return (
    <div className="overflow-x-auto">
      <table className="w-full min-w-[600px] border-collapse">
        <thead>
          {/* Apartment headers with images */}
          <tr>
            <th className="w-36 p-3 text-right text-xs font-semibold text-muted-foreground bg-muted/30 rounded-tr-lg">
              معيار المقارنة
            </th>
            {apartments.map((apt) => (
              <th key={apt.id} className="p-3 text-center bg-muted/30 last:rounded-tl-lg">
                <div
                  className="mx-auto mb-2 h-24 w-full max-w-48 overflow-hidden rounded-xl shadow-md"
                  style={{ background: apt.gradient }}
                >
                  <div className="flex h-full items-center justify-center opacity-30">
                    <Building2 className="size-12 text-white" />
                  </div>
                </div>
                <p className="text-xs font-bold leading-tight line-clamp-2">
                  {apt.title}
                </p>
              </th>
            ))}
          </tr>
        </thead>
        <tbody>
          {rows.map((row, idx) => (
            <tr
              key={row.label}
              className={`transition-colors hover:bg-muted/20 ${
                idx % 2 === 0 ? "bg-background" : "bg-muted/10"
              }`}
            >
              <td className="p-3">
                <div className="flex items-center gap-2">
                  {row.icon}
                  <span className="text-xs font-semibold">{row.label}</span>
                </div>
              </td>
              {apartments.map((apt) => {
                const isBest = row.bestKey
                  ? bestValues[row.bestKey] === apt.id
                  : false;
                return (
                  <td
                    key={apt.id}
                    className="p-3 text-center align-top"
                  >
                    <div className="flex flex-col items-center gap-1">
                      {row.getValue(apt)}
                      <BestBadge
                        isBest={isBest}
                        label={row.bestLabel || ""}
                      />
                    </div>
                  </td>
                );
              })}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  );
}

/* ==========================================================================
   SECTION 9: AI Analysis Component (تحليل بالذكاء الاصطناعي)
   ========================================================================== */

function AIAnalysisPanel({
  apartments,
  analysis,
  isLoading,
  onAnalyze,
}: {
  apartments: Apartment[];
  analysis: AIAnalysis | null;
  isLoading: boolean;
  onAnalyze: () => void;
}) {
  const [isExpanded, setIsExpanded] = useState(true);

  return (
    <motion.div
      initial={{ opacity: 0, y: 20 }}
      animate={{ opacity: 1, y: 0 }}
      className="rounded-2xl border border-purple-200 bg-gradient-to-br from-purple-50 to-violet-50 p-4 dark:border-purple-800 dark:from-purple-950/30 dark:to-violet-950/30 sm:p-6"
    >
      {/* Header */}
      <div className="mb-4 flex items-center justify-between">
        <div className="flex items-center gap-2">
          <div className="flex size-8 items-center justify-center rounded-xl bg-gradient-to-br from-purple-500 to-violet-600 shadow-md shadow-purple-500/20">
            <Sparkles className="size-4 text-white" />
          </div>
          <div>
            <h3 className="text-sm font-bold">تحليل بالذكاء الاصطناعي</h3>
            <p className="text-[11px] text-muted-foreground">
              توصيات ذكية بناءً على بيانات الشقق
            </p>
          </div>
        </div>

        <Button
          onClick={onAnalyze}
          disabled={isLoading}
          className="gap-2 bg-gradient-to-l from-purple-600 to-violet-600 text-white shadow-lg shadow-purple-500/20 hover:from-purple-700 hover:to-violet-700"
          size="sm"
        >
          {isLoading ? (
            <>
              <Loader2 className="size-4 animate-spin" />
              <span className="hidden sm:inline">جاري التحليل...</span>
            </>
          ) : analysis ? (
            <>
              <Sparkles className="size-4" />
              <span className="hidden sm:inline">إعادة التحليل</span>
            </>
          ) : (
            <>
              <Sparkles className="size-4" />
              <span className="hidden sm:inline">تحليل الشقق</span>
            </>
          )}
        </Button>
      </div>

      {/* Analysis Result */}
      <AnimatePresence mode="wait">
        {isLoading && (
          <motion.div
            key="loading"
            initial={{ opacity: 0 }}
            animate={{ opacity: 1 }}
            exit={{ opacity: 0 }}
            className="flex flex-col items-center gap-3 py-8"
          >
            <div className="relative">
              <div className="size-12 rounded-full border-4 border-purple-200" />
              <motion.div
                className="absolute inset-0 size-12 rounded-full border-4 border-transparent border-t-purple-600"
                animate={{ rotate: 360 }}
                transition={{ duration: 1, repeat: Infinity, ease: "linear" }}
              />
            </div>
            <p className="text-sm text-muted-foreground">
              جاري تحليل {apartments.length} شقق...
            </p>
          </motion.div>
        )}

        {analysis && !isLoading && (
          <motion.div
            key="result"
            initial={{ opacity: 0, y: 10 }}
            animate={{ opacity: 1, y: 0 }}
            exit={{ opacity: 0 }}
            className="space-y-4"
          >
            {/* Recommendation */}
            <div className="rounded-xl border border-emerald-200 bg-emerald-50 p-4 dark:border-emerald-800 dark:bg-emerald-950/30">
              <div className="mb-2 flex items-center gap-2">
                <Trophy className="size-4 text-emerald-600" />
                <span className="text-sm font-bold text-emerald-700 dark:text-emerald-400">
                  التوصية الأفضل
                </span>
              </div>
              <p className="text-sm leading-relaxed">{analysis.recommendation}</p>
            </div>

            {/* Pros & Cons */}
            <button
              onClick={() => setIsExpanded(!isExpanded)}
              className="flex w-full items-center justify-between rounded-xl border border-border bg-background/50 p-3 text-sm font-semibold transition-colors hover:bg-muted/30"
            >
              <span className="flex items-center gap-2">
                <ArrowUpDown className="size-4 text-purple-600" />
                المميزات والعيوب لكل شقة
              </span>
              {isExpanded ? (
                <ChevronUp className="size-4" />
              ) : (
                <ChevronDown className="size-4" />
              )}
            </button>

            <AnimatePresence>
              {isExpanded && (
                <motion.div
                  initial={{ height: 0, opacity: 0 }}
                  animate={{ height: "auto", opacity: 1 }}
                  exit={{ height: 0, opacity: 0 }}
                  transition={{ duration: 0.3 }}
                  className="overflow-hidden"
                >
                  <div className="space-y-3">
                    {/* Pros */}
                    {analysis.pros.map((item) => (
                      <div
                        key={item.apartmentId}
                        className="rounded-xl border border-emerald-200/50 bg-background p-3 dark:border-emerald-900/30"
                      >
                        <h4 className="mb-2 text-xs font-bold text-emerald-700 dark:text-emerald-400">
                          ✓ {item.title}
                        </h4>
                        <ul className="space-y-1">
                          {item.points.map((point, i) => (
                            <li
                              key={i}
                              className="flex items-start gap-2 text-xs text-muted-foreground"
                            >
                              <CheckCircle2 className="mt-0.5 size-3.5 shrink-0 text-emerald-500" />
                              {point}
                            </li>
                          ))}
                        </ul>
                      </div>
                    ))}

                    {/* Cons */}
                    {analysis.cons.map((item) => (
                      <div
                        key={item.apartmentId}
                        className="rounded-xl border border-red-200/50 bg-background p-3 dark:border-red-900/30"
                      >
                        <h4 className="mb-2 text-xs font-bold text-red-600 dark:text-red-400">
                          ✗ {item.title}
                        </h4>
                        <ul className="space-y-1">
                          {item.points.map((point, i) => (
                            <li
                              key={i}
                              className="flex items-start gap-2 text-xs text-muted-foreground"
                            >
                              <XCircle className="mt-0.5 size-3.5 shrink-0 text-red-400" />
                              {point}
                            </li>
                          ))}
                        </ul>
                      </div>
                    ))}
                  </div>
                </motion.div>
              )}
            </AnimatePresence>

            {/* Verdict */}
            <div className="rounded-xl border border-purple-200 bg-gradient-to-r from-purple-50 to-violet-50 p-4 dark:border-purple-800 dark:from-purple-950/40 dark:to-violet-950/40">
              <div className="mb-2 flex items-center gap-2">
                <Sparkles className="size-4 text-purple-600" />
                <span className="text-sm font-bold text-purple-700 dark:text-purple-400">
                  الحكم النهائي
                </span>
              </div>
              <p className="text-sm leading-relaxed">{analysis.verdict}</p>
            </div>
          </motion.div>
        )}

        {!analysis && !isLoading && (
          <motion.div
            key="empty"
            initial={{ opacity: 0 }}
            animate={{ opacity: 1 }}
            exit={{ opacity: 0 }}
            className="flex flex-col items-center gap-2 py-6 text-center"
          >
            <Sparkles className="size-8 text-purple-300" />
            <p className="text-xs text-muted-foreground">
              اضغط &quot;تحليل الشقق&quot; للحصول على توصيات ذكية ومقارنة
              شاملة
            </p>
          </motion.div>
        )}
      </AnimatePresence>
    </motion.div>
  );
}

/* ==========================================================================
   SECTION 10: Compare Dialog Component (نافذة المقارنة)
   ========================================================================== */

function CompareDialog({
  open,
  onClose,
  apartments,
}: {
  open: boolean;
  onClose: () => void;
  apartments: Apartment[];
}) {
  const [analysis, setAnalysis] = useState<AIAnalysis | null>(null);
  const [isAnalyzing, setIsAnalyzing] = useState(false);
  const [activeTab, setActiveTab] = useState<"table" | "ai">("table");

  const handleAIAnalysis = useCallback(async () => {
    setIsAnalyzing(true);
    try {
      const res = await fetch("/api/compare-ai", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ apartments }),
      });
      const data = await res.json();
      if (data.analysis) {
        setAnalysis(data.analysis);
        setActiveTab("ai");
      }
    } catch (err) {
      console.error("AI Analysis error:", err);
    } finally {
      setIsAnalyzing(false);
    }
  }, [apartments]);

  // Reset when dialog opens
  React.useEffect(() => {
    if (open) {
      setAnalysis(null);
      setActiveTab("table");
    }
  }, [open]);

  return (
    <Dialog open={open} onOpenChange={(v) => !v && onClose()}>
      <DialogContent className="flex h-[92vh] max-w-6xl flex-col gap-0 overflow-hidden rounded-2xl p-0 sm:h-[88vh]">
        {/* Dialog Header */}
        <div className="flex items-center justify-between border-b border-border/50 px-4 py-3 sm:px-6">
          <div className="flex items-center gap-3">
            <div className="flex size-9 items-center justify-center rounded-xl bg-gradient-to-br from-emerald-500 to-teal-600 shadow-md">
              <GitCompareArrows className="size-5 text-white" />
            </div>
            <div>
              <DialogTitle className="text-base font-bold">
                مقارنة الشقق
              </DialogTitle>
              <DialogDescription className="text-xs">
                مقارنة تفصيلية بين {apartments.length} شقق
              </DialogDescription>
            </div>
          </div>

          <div className="flex items-center gap-2">
            {/* AI Analysis button */}
            <Button
              onClick={handleAIAnalysis}
              disabled={isAnalyzing}
              variant="outline"
              size="sm"
              className="gap-1.5 border-purple-300 text-purple-700 hover:bg-purple-50 dark:border-purple-700 dark:text-purple-400 dark:hover:bg-purple-950/30"
            >
              {isAnalyzing ? (
                <Loader2 className="size-4 animate-spin" />
              ) : (
                <Sparkles className="size-4" />
              )}
              <span className="hidden sm:inline">تحليل AI</span>
            </Button>
          </div>
        </div>

        {/* Tabs */}
        <div className="flex border-b border-border/50 bg-muted/30">
          <button
            onClick={() => setActiveTab("table")}
            className={`flex-1 px-4 py-2.5 text-sm font-medium transition-colors ${
              activeTab === "table"
                ? "border-b-2 border-emerald-500 text-emerald-700 dark:text-emerald-400"
                : "text-muted-foreground hover:text-foreground"
            }`}
          >
            <span className="flex items-center justify-center gap-2">
              <GitCompareArrows className="size-4" />
              جدول المقارنة
            </span>
          </button>
          <button
            onClick={() => setActiveTab("ai")}
            className={`flex-1 px-4 py-2.5 text-sm font-medium transition-colors ${
              activeTab === "ai"
                ? "border-b-2 border-purple-500 text-purple-700 dark:text-purple-400"
                : "text-muted-foreground hover:text-foreground"
            }`}
          >
            <span className="flex items-center justify-center gap-2">
              <Sparkles className="size-4" />
              تحليل الذكاء الاصطناعي
            </span>
          </button>
        </div>

        {/* Content */}
        <div className="flex-1 overflow-y-auto">
          {activeTab === "table" ? (
            <div className="p-4 sm:p-6">
              <ComparisonTable apartments={apartments} />
            </div>
          ) : (
            <div className="p-4 sm:p-6">
              <AIAnalysisPanel
                apartments={apartments}
                analysis={analysis}
                isLoading={isAnalyzing}
                onAnalyze={handleAIAnalysis}
              />
            </div>
          )}
        </div>
      </DialogContent>
    </Dialog>
  );
}

/* ==========================================================================
   SECTION 11: Main Page Component (الصفحة الرئيسية)
   ========================================================================== */

export default function ManteqtiComparisonPage() {
  /* --- State --- */
  const [favorites, setFavorites] = useState<Set<string>>(new Set());
  const [selectedIds, setSelectedIds] = useState<Set<string>>(new Set());
  const [favoritesOpen, setFavoritesOpen] = useState(false);
  const [compareOpen, setCompareOpen] = useState(false);
  const [searchQuery, setSearchQuery] = useState("");
  const [filterType, setFilterType] = useState<"all" | "إيجار" | "بيع">(
    "all"
  );

  /* --- Derived --- */
  const favoriteApartments = useMemo(
    () => mockApartments.filter((apt) => favorites.has(apt.id)),
    [favorites]
  );

  const selectedApartments = useMemo(
    () => mockApartments.filter((apt) => selectedIds.has(apt.id)),
    [selectedIds]
  );

  const filteredApartments = useMemo(() => {
    return mockApartments.filter((apt) => {
      const matchSearch =
        !searchQuery ||
        apt.title.includes(searchQuery) ||
        apt.city.includes(searchQuery) ||
        apt.location.includes(searchQuery);
      const matchType = filterType === "all" || apt.type === filterType;
      return matchSearch && matchType;
    });
  }, [searchQuery, filterType]);

  /* --- Handlers --- */
  const toggleFavorite = useCallback((id: string) => {
    setFavorites((prev) => {
      const next = new Set(prev);
      if (next.has(id)) {
        next.delete(id);
        // Also remove from selection
        setSelectedIds((s) => {
          const n = new Set(s);
          n.delete(id);
          return n;
        });
      } else {
        next.add(id);
      }
      return next;
    });
  }, []);

  const toggleSelect = useCallback(
    (id: string) => {
      setSelectedIds((prev) => {
        const next = new Set(prev);
        if (next.has(id)) {
          next.delete(id);
        } else if (next.size < 4) {
          next.add(id);
        }
        return next;
      });
    },
    []
  );

  const openCompare = useCallback(() => {
    setFavoritesOpen(false);
    setCompareOpen(true);
  }, []);

  /* --- Render --- */
  return (
    <ManteqtiThemeWrapper>
      <div className="min-h-screen bg-background">
        {/* ========== Header ========== */}
        <Header
          favoritesCount={favoriteApartments.length}
          onSelectCompare={openCompare}
          selectedCount={selectedIds.size}
          onOpenFavorites={() => setFavoritesOpen(true)}
        />

        <main className="mx-auto max-w-7xl px-4 py-6 sm:px-6 sm:py-8">
          {/* ========== Page Title Section ========== */}
          <motion.div
            initial={{ opacity: 0, y: -10 }}
            animate={{ opacity: 1, y: 0 }}
            className="mb-6 sm:mb-8"
          >
            <div className="rounded-2xl bg-gradient-to-l from-emerald-600 via-teal-600 to-cyan-600 p-6 text-white shadow-xl shadow-emerald-500/10 sm:p-8">
              <div className="flex items-center gap-3 mb-2">
                <h2 className="text-2xl font-bold sm:text-3xl">
                  اكتشف وحدد شقتك المثالية
                </h2>
                <Badge className="bg-white/20 text-white text-xs hover:bg-white/20">
                  NEW
                </Badge>
              </div>
              <p className="text-sm text-white/80 sm:text-base">
                تصفح الشقق المتاحة، أضف ما يعجبك للمفضلات، وقارن بينها بسهولة
                بمساعدة الذكاء الاصطناعي
              </p>

              {/* Quick stats */}
              <div className="mt-4 flex flex-wrap gap-4 sm:gap-6">
                <div className="flex items-center gap-2 text-sm">
                  <div className="flex size-8 items-center justify-center rounded-lg bg-white/20">
                    <Building2 className="size-4" />
                  </div>
                  <div>
                    <p className="font-bold">{mockApartments.length}</p>
                    <p className="text-[10px] text-white/70">شقة متاحة</p>
                  </div>
                </div>
                <div className="flex items-center gap-2 text-sm">
                  <div className="flex size-8 items-center justify-center rounded-lg bg-white/20">
                    <Heart className="size-4" />
                  </div>
                  <div>
                    <p className="font-bold">{favoriteApartments.length}</p>
                    <p className="text-[10px] text-white/70">في المفضلات</p>
                  </div>
                </div>
                <div className="flex items-center gap-2 text-sm">
                  <div className="flex size-8 items-center justify-center rounded-lg bg-white/20">
                    <GitCompareArrows className="size-4" />
                  </div>
                  <div>
                    <p className="font-bold">{selectedIds.size}</p>
                    <p className="text-[10px] text-white/70">للمقارنة</p>
                  </div>
                </div>
              </div>
            </div>
          </motion.div>

          {/* ========== Filters Section ========== */}
          <motion.div
            initial={{ opacity: 0, y: 10 }}
            animate={{ opacity: 1, y: 0 }}
            transition={{ delay: 0.1 }}
            className="mb-6 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between"
          >
            {/* Search */}
            <div className="relative flex-1 sm:max-w-sm">
              <MapPin className="absolute right-3 top-1/2 size-4 -translate-y-1/2 text-muted-foreground" />
              <input
                type="text"
                placeholder="ابحث حسب المنطقة أو العنوان..."
                value={searchQuery}
                onChange={(e) => setSearchQuery(e.target.value)}
                className="h-10 w-full rounded-xl border border-border bg-background pr-10 pl-4 text-sm outline-none transition-colors focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/20"
              />
            </div>

            {/* Type Filter */}
            <div className="flex items-center gap-2 rounded-xl border border-border bg-muted/30 p-1">
              {(["all", "إيجار", "بيع"] as const).map((type) => (
                <button
                  key={type}
                  onClick={() => setFilterType(type)}
                  className={`rounded-lg px-3 py-1.5 text-xs font-medium transition-all ${
                    filterType === type
                      ? "bg-background text-foreground shadow-sm"
                      : "text-muted-foreground hover:text-foreground"
                  }`}
                >
                  {type === "all" ? "الكل" : type === "إيجار" ? "للإيجار" : "للبيع"}
                </button>
              ))}
            </div>

            {/* Results count */}
            <span className="text-xs text-muted-foreground">
              {filteredApartments.length} نتيجة
            </span>
          </motion.div>

          {/* ========== Apartments Grid ========== */}
          <div className="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3 xl:gap-6">
            <AnimatePresence mode="popLayout">
              {filteredApartments.map((apt) => (
                <ApartmentCard
                  key={apt.id}
                  apartment={apt}
                  isFavorite={favorites.has(apt.id)}
                  isSelected={selectedIds.has(apt.id)}
                  onToggleFavorite={() => toggleFavorite(apt.id)}
                  onToggleSelect={() => {
                    if (favorites.has(apt.id)) {
                      toggleSelect(apt.id);
                    }
                  }}
                />
              ))}
            </AnimatePresence>
          </div>

          {/* Empty State */}
          {filteredApartments.length === 0 && (
            <motion.div
              initial={{ opacity: 0 }}
              animate={{ opacity: 1 }}
              className="flex flex-col items-center gap-3 py-16 text-center"
            >
              <div className="flex size-16 items-center justify-center rounded-full bg-muted">
                <Building2 className="size-8 text-muted-foreground" />
              </div>
              <p className="text-sm font-medium">لا توجد نتائج</p>
              <p className="text-xs text-muted-foreground">
                جرب تغيير معايير البحث
              </p>
              <Button
                variant="outline"
                size="sm"
                onClick={() => {
                  setSearchQuery("");
                  setFilterType("all");
                }}
              >
                إعادة تعيين الفلاتر
              </Button>
            </motion.div>
          )}

          {/* ========== Quick Compare Floating Button (Mobile) ========== */}
          <AnimatePresence>
            {selectedIds.size >= 2 && (
              <motion.div
                initial={{ scale: 0, y: 50 }}
                animate={{ scale: 1, y: 0 }}
                exit={{ scale: 0, y: 50 }}
                className="fixed bottom-6 left-1/2 z-30 -translate-x-1/2 sm:hidden"
              >
                <Button
                  onClick={openCompare}
                  className="gap-2 rounded-full bg-gradient-to-l from-emerald-600 to-teal-600 px-6 py-6 text-white shadow-2xl shadow-emerald-500/30"
                >
                  <GitCompareArrows className="size-5" />
                  مقارنة ({selectedIds.size})
                </Button>
              </motion.div>
            )}
          </AnimatePresence>

          {/* ========== How it works Section ========== */}
          <motion.div
            initial={{ opacity: 0, y: 20 }}
            animate={{ opacity: 1, y: 0 }}
            transition={{ delay: 0.3 }}
            className="mt-12 rounded-2xl border border-border/50 bg-muted/20 p-6 sm:p-8"
          >
            <h3 className="mb-6 text-center text-lg font-bold">
              كيف تستخدم المقارنة؟
            </h3>
            <div className="grid grid-cols-1 gap-4 sm:grid-cols-3">
              {[
                {
                  icon: <Heart className="size-6 text-red-500" />,
                  step: "١",
                  title: "أضف للمفضلات",
                  desc: "اضغط على أيقونة القلب في الشقق التي تعجبك",
                },
                {
                  icon: <GitCompareArrows className="size-6 text-emerald-600" />,
                  step: "٢",
                  title: "اختر للمقارنة",
                  desc: "حدد من ٢ إلى ٤ شقق من لوحة المفضلات",
                },
                {
                  icon: <Sparkles className="size-6 text-purple-500" />,
                  step: "٣",
                  title: "احصل على توصية",
                  desc: "استخدم تحليل الذكاء الاصطناعي للحصول على أفضل خيار",
                },
              ].map((item) => (
                <div
                  key={item.step}
                  className="flex flex-col items-center gap-3 rounded-xl bg-background p-4 text-center shadow-sm"
                >
                  <div className="flex size-12 items-center justify-center rounded-full bg-muted">
                    {item.icon}
                  </div>
                  <span className="text-xs font-bold text-muted-foreground">
                    الخطوة {item.step}
                  </span>
                  <h4 className="text-sm font-bold">{item.title}</h4>
                  <p className="text-xs text-muted-foreground">{item.desc}</p>
                </div>
              ))}
            </div>
          </motion.div>

          {/* ========== Footer ========== */}
          <footer className="mt-8 border-t border-border/50 pb-6 pt-6 text-center text-xs text-muted-foreground">
            <p>منطقتي | Manteqti © 2024 - صفحة عرض ميزة المقارنة</p>
          </footer>
        </main>

        {/* ========== Favorites Sheet ========== */}
        <Sheet open={favoritesOpen} onOpenChange={setFavoritesOpen}>
          <SheetContent
            side="left"
            className="w-[90vw] border-r-border/50 sm:max-w-md"
          >
            <FavoritesPanel
              favorites={favoriteApartments}
              selectedIds={selectedIds}
              onToggleSelect={toggleSelect}
              onRemove={toggleFavorite}
              onOpenCompare={openCompare}
            />
          </SheetContent>
        </Sheet>

        {/* ========== Comparison Dialog ========== */}
        <CompareDialog
          open={compareOpen}
          onClose={() => setCompareOpen(false)}
          apartments={selectedApartments}
        />
      </div>
    </ManteqtiThemeWrapper>
  );
}
