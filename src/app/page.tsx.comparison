/* ==========================================================================
   SECTION 1: TypeScript Types
   ========================================================================== */

type ApartmentType = "إيجار" | "بيع";
type Furnishing = "مفروشة" | "نصف مفروشة" | "غير مفروشة";

interface Amenity {
  icon: React.ReactNode;
  label: string;
}

interface Apartment {
  id: string;
  title: string;
  description: string;
  type: ApartmentType;
  price: number; // EGP per month (rent) or total (sale)
  area: number; // sqm
  bedrooms: number;
  bathrooms: number;
  floor: number;
  totalFloors: number;
  location: string;
  city: string;
  furnishing: Furnishing;
  yearBuilt: number;
  status: string;
  gradient: string; // CSS gradient for image placeholder
  amenities: Amenity[];
  images: string[]; // placeholder image URLs
  rating: number;
  viewsCount: number;
  contactPhone: string;
}

interface AIAnalysis {
  recommendation: string;
  pros: { apartmentId: string; title: string; points: string[] };
  cons: { apartmentId: string; title: string; points: string[] };
  verdict: string;
}

