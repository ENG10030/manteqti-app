// This is your Prisma schema file for PRODUCTION (PostgreSQL)
// Use this file when deploying to Vercel/Supabase

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

model User {
  id                    String    @id @default(cuid())
  identifier            String    @unique
  name                  String
  password              String
  phone                 String?
  email                 String?
  role                  String    @default("user")
  isBlocked             Boolean   @default(false)
  blockedAt             DateTime?
  blockReason           String?
  isApproved            Boolean   @default(true)
  passwordResetToken    String?
  passwordResetExpires  DateTime?
  otp                   String?
  otpExpires            DateTime? @map("otp_expires")
  emailVerified         Boolean   @default(false)
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  apartments      Apartment[]           @relation("ApartmentCreator")
  inquiries       Inquiry[]
  payments        Payment[]
  likes           Like[]
  comments        Comment[]
  editRequests    PropertyEditRequest[]
  messagesSent    Message[]             @relation("MessageSender")
  messagesRecvd  Message[]             @relation("MessageRecipient")
  blockedUsers   BlockedUser[]        @relation("BlockedBy")
  blockedBy       BlockedUser[]        @relation("Blocked")

  @@map("users")
}

model Apartment {
  id              String      @id @default(cuid())
  title           String
  price           Int
  area            String
  bedrooms        Int
  bathrooms       Int
  floor           Int?
  totalFloors     Int?
  apartmentSize   Int?
  description     String      @db.Text
  ownerPhone      String      @map("owner_phone")
  mapLink         String?     @map("map_link") @db.Text
  imageUrl        String?     @map("image_url") @db.Text
  images          String?     @db.Text
  videoUrl        String?     @map("video_url") @db.Text
  videos          String?     @db.Text
  amenities       String?     @db.Text
  featured        Boolean     @default(false) @map("featured")
  isFeatured      Boolean     @default(false) @map("is_featured")
  isVip           Boolean     @default(false) @map("is_vip")
  contactHidden   Boolean     @default(false) @map("contact_hidden")
  type            String
  status          String      @default("pending")
  statusChangedAt DateTime?   @map("status_changed_at")
  views           Int         @default(0)
  paymentRef      String?     @map("payment_ref")
  agreementStatus String?     @map("agreement_status")
  createdBy       String?     @map("created_by")
  approvedBy      String?     @map("approved_by")
  approvedAt      DateTime?   @map("approved_at")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  user          User?      @relation("ApartmentCreator", fields: [createdBy], references: [id])
  inquiries     Inquiry[]
  likes         Like[]
  comments      Comment[]
  editRequests  PropertyEditRequest[]

  @@index([status])
  @@index([type])
  @@index([area])
  @@index([createdBy])
  @@map("apartments")
}

model Inquiry {
  id               String    @id @default(cuid())
  apartmentId      String    @map("apartment_id")
  userId           String?   @map("user_id")
  name             String
  email            String
  phone            String
  message          String    @db.Text
  lifecycleStatus  String    @default("New") @map("lifecycle_status")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  apartment Apartment @relation(fields: [apartmentId], references: [id], onDelete: Cascade)
  user      User?      @relation(fields: [userId], references: [id])
  payment   Payment?

  @@index([apartmentId])
  @@index([userId])
  @@map("inquiries")
}

model Payment {
  id             String    @id @default(cuid())
  inquiryId      String    @unique @map("inquiry_id")
  method         String
  status         String    @default("Pending")
  inquiryStatus  String    @default("Contacted") @map("inquiry_status")
  amount         Int
  transactionRef String?   @map("transaction_ref")
  paymentLink    String?   @map("payment_link") @db.Text
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  inquiry Inquiry @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id])
  userId  String? @map("user_id")

  @@map("payments")
}

model Message {
  id         String   @id @default(cuid())
  senderId   String   @map("sender_id")
  receiverId String   @map("receiver_id")
  content    String   @db.Text
  read       Boolean  @default(false)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  sender   User @relation("MessageSender", fields: [senderId], references: [id])
  receiver User @relation("MessageRecipient", fields: [receiverId], references: [id])

  @@index([senderId])
  @@index([receiverId])
  @@map("messages")
}

model Like {
  id           String    @id @default(cuid())
  userId       String    @map("user_id")
  apartmentId  String    @map("apartment_id")
  createdAt    DateTime  @default(now()) @map("created_at")

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  apartment Apartment @relation(fields: [apartmentId], references: [id], onDelete: Cascade)

  @@unique([apartmentId, userId])
  @@index([apartmentId])
  @@map("likes")
}

model Comment {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  apartmentId String   @map("apartment_id")
  content     String   @db.Text
  status      String   @default("pending")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  apartment Apartment @relation(fields: [apartmentId], references: [id], onDelete: Cascade)

  @@index([apartmentId])
  @@map("comments")
}

model BlockedUser {
  id          String   @id @default(cuid())
  blockerId   String   @map("blocker_id")
  blockedId   String   @map("blocked_id")
  blockedAt   DateTime @default(now()) @map("blocked_at")
  createdAt   DateTime @default(now()) @map("created_at")

  blocker User @relation("BlockedBy", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@map("blocked_users")
}

model ApprovalLog {
  id          String   @id @default(cuid())
  userId      String?  @map("user_id")
  action      String
  userName    String?  @map("user_name")
  userEmail   String?  @map("user_email")
  reason      String?  @db.Text
  performedBy String?  @map("performed_by")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("approval_logs")
}

model PropertyEditRequest {
  id           String    @id @default(cuid())
  apartmentId  String    @map("apartment_id")
  userId       String    @map("user_id")
  editType     String    @default("multiple") @map("edit_type")
  newImages    String?   @db.Text
  newVideos    String?   @db.Text
  newPrice     Int?
  newStatus    String?   @map("new_status")
  description  String?   @db.Text
  status       String    @default("pending")
  reviewedBy   String?   @map("reviewed_by")
  reviewedAt   DateTime? @map("reviewed_at")
  reviewNotes  String?   @db.Text @map("review_notes")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  apartment Apartment @relation(fields: [apartmentId], references: [id], onDelete: Cascade)
  user      User?      @relation(fields: [userId], references: [id])

  @@index([apartmentId])
  @@index([userId])
  @@index([status])
  @@map("property_edit_requests")
}

model OtpCode {
  id        String   @id @default(cuid())
  code      String
  email     String
  createdAt DateTime @default(now()) @map("created_at")
  expiresAt DateTime @map("expires_at")

  @@map("otp_codes")
}

model OperationLog {
  id          String   @id @default(cuid())
  action      String
  entityType  String   @map("entity_type")
  entityId    String?  @map("entity_id")
  userId      String?  @map("user_id")
  details     String?  @db.Text
  ipAddress   String?  @map("ip_address")
  userAgent   String?  @map("user_agent") @db.Text
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("operation_logs")
}

model Settings {
  id                  String   @id @default("main")
  contactFee          Int      @default(50) @map("contact_fee")
  regularFee          Int      @default(30) @map("regular_fee")
  featuredFee         Int      @default(100) @map("featured_fee")
  premiumFee          Int      @default(200) @map("premium_fee")
  vipFee              Int      @default(300) @map("vip_fee")
  saleDisplayFee      Int      @default(100) @map("sale_display_fee")
  rentDisplayFee      Int      @default(75) @map("rent_display_fee")
  otherServicesFee    Int      @default(50) @map("other_services_fee")
  highlightFee        Int      @default(150) @map("highlight_fee")
  priorityListingFee  Int      @default(200) @map("priority_listing_fee")
  verifiedListingFee  Int      @default(250) @map("verified_listing_fee")
  minRechargeAmount   Int      @default(10) @map("min_recharge_amount")
  maxRechargeAmount   Int      @default(50000) @map("max_recharge_amount")
  currency            String   @default("ج.م")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@map("settings")
}

model Session {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  token        String   @unique
  expiresAt    DateTime @map("expires_at")
  ipAddress    String?  @map("ip_address")
  userAgent    String?  @map("user_agent") @db.Text
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("sessions")
}

model SecurityLog {
  id          String   @id @default(cuid())
  action      String
  identifier  String
  ipAddress   String?  @map("ip_address")
  userAgent   String?  @map("user_agent") @db.Text
  details     String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("security_logs")
}
