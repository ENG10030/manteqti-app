// Manteqti - PostgreSQL Schema for PRODUCTION (Vercel/Supabase)
// COMPLETE schema matching ALL models used in the codebase
// Build command: cp prisma/schema.postgres.prisma prisma/schema.prisma && bun run db:generate && (bun run db:push || true) && bun run build

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

model User {
  id                    String    @id @default(cuid())
  identifier            String    @unique @map("identifier")
  name                  String    @map("name")
  email                 String?   @map("email")
  phone                 String?   @map("phone")
  password              String    @map("password")
  role                  String    @default("user") @map("role")
  isBlocked             Boolean   @default(false) @map("is_blocked")
  blockedAt             DateTime? @map("blocked_at")
  blockReason           String?   @map("block_reason")
  isApproved            Boolean   @default(true) @map("is_approved")
  passwordResetToken    String?   @map("password_reset_token")
  passwordResetExpires  DateTime? @map("password_reset_expires")
  otp                   String?   @map("otp")
  otpExpires            DateTime? @map("otp_expires")
  emailVerified         Boolean   @default(false) @map("email_verified")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  apartments    Apartment[]
  inquiries     Inquiry[]
  payments      Payment[]
  likes         Like[]
  comments      Comment[]
  messages      Message[]
  editRequests  PropertyEditRequest[]
  blockedUsers  BlockedUser[]  @relation("BlockedUserRelation")
  sentMessages  Message[]     @relation("SenderMessages")

  @@map("users")
}

model Apartment {
  id               String    @id @default(cuid())
  title            String    @map("title")
  price            Int       @map("price")
  area             String    @map("area")
  bedrooms         Int       @map("bedrooms")
  bathrooms        Int       @map("bathrooms")
  floor            Int?      @map("floor")
  apartmentSize    Int?      @map("apartment_size")
  description      String    @db.Text @map("description")
  ownerPhone       String    @map("owner_phone")
  mapLink          String?   @db.Text @map("map_link")
  imageUrl         String?   @db.Text @map("image_url")
  images           String?   @db.Text @map("images")
  videoUrl         String?   @db.Text @map("video_url")
  videos           String?   @db.Text @map("videos")
  amenities        String?   @db.Text @map("amenities")
  isFeatured       Boolean   @default(false) @map("is_featured")
  isVip            Boolean   @default(false) @map("is_vip")
  type             String    @default("rent") @map("type")
  status           String    @default("pending") @map("status")
  statusChangedAt  DateTime? @map("status_changed_at")
  paymentRef       String?   @map("payment_ref")
  createdBy        String?   @map("created_by")
  approvedBy       String?   @map("approved_by")
  approvedAt       DateTime? @map("approved_at")
  contactHidden    Boolean   @default(false) @map("contact_hidden")
  views            Int       @default(0) @map("views")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  user          User?         @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  inquiries     Inquiry[]
  likes         Like[]
  comments      Comment[]
  editRequests  PropertyEditRequest[]

  @@index([status])
  @@index([type])
  @@index([area])
  @@map("apartments")
}

model Inquiry {
  id              String   @id @default(cuid())
  apartmentId     String   @map("apartment_id")
  userId          String?  @map("user_id")
  name            String   @map("name")
  email           String   @map("email")
  phone           String   @map("phone")
  message         String   @db.Text @map("message")
  lifecycleStatus String   @default("new") @map("lifecycle_status")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  apartment Apartment @relation(fields: [apartmentId], references: [id], onDelete: Cascade)
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  payment   Payment?

  @@index([apartmentId])
  @@map("inquiries")
}

model Payment {
  id             String   @id @default(cuid())
  inquiryId      String   @unique @map("inquiry_id")
  method         String   @map("method")
  status         String   @default("Pending") @map("status")
  inquiryStatus  String   @default("new") @map("inquiry_status")
  amount         Int      @map("amount")
  transactionRef String?  @map("transaction_ref")
  paymentLink    String?  @db.Text @map("payment_link")
  userId         String?  @map("user_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  inquiry Inquiry @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("payments")
}

model Like {
  id          String   @id @default(cuid())
  apartmentId String   @map("apartment_id")
  userId      String   @map("user_id")
  createdAt   DateTime @default(now()) @map("created_at")

  apartment Apartment @relation(fields: [apartmentId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([apartmentId, userId])
  @@index([userId])
  @@map("likes")
}

model Comment {
  id          String   @id @default(cuid())
  apartmentId String   @map("apartment_id")
  userId      String   @map("user_id")
  content     String   @db.Text @map("content")
  status      String   @default("pending") @map("status")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  apartment Apartment @relation(fields: [apartmentId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([apartmentId])
  @@index([userId])
  @@map("comments")
}

model Message {
  id         String    @id @default(cuid())
  senderId   String    @map("sender_id")
  receiverId String?   @map("receiver_id")
  content    String    @db.Text @map("content")
  isRead     Boolean   @default(false) @map("is_read")
  createdAt  DateTime  @default(now()) @map("created_at")

  sender   User @relation("SenderMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User? @relation(fields: [receiverId], references: [id], onDelete: SetNull)

  @@index([senderId])
  @@index([receiverId])
  @@map("messages")
}

model PropertyEditRequest {
  id           String   @id @default(cuid())
  apartmentId  String   @map("apartment_id")
  userId       String   @map("user_id")
  editType     String   @default("update") @map("edit_type")
  changes      String?  @db.Text @map("changes")
  newImages    String?  @db.Text @map("new_images")
  newVideos    String?  @db.Text @map("new_videos")
  newPrice     Int?     @map("new_price")
  newStatus    String?  @map("new_status")
  description  String?  @db.Text @map("description")
  status       String   @default("pending") @map("status")
  reviewedBy   String?  @map("reviewed_by")
  reviewedAt   DateTime? @map("reviewed_at")
  reviewNotes  String?  @db.Text @map("review_notes")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  apartment Apartment @relation(fields: [apartmentId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([apartmentId])
  @@index([userId])
  @@map("property_edit_requests")
}

model BlockedUser {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  reason    String?  @db.Text @map("reason")
  blockedAt DateTime @default(now()) @map("blocked_at")

  user User @relation("BlockedUserRelation", fields: [userId], references: [id], onDelete: Cascade)

  @@map("blocked_users")
}

model ApprovalLog {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  action      String   @map("action")
  userName    String   @map("user_name")
  userEmail   String?  @map("user_email")
  reason      String?  @db.Text @map("reason")
  performedBy String?  @map("performed_by")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("approval_logs")
}

// CRITICAL: Settings uses FIXED ID "main" to ensure exactly ONE row exists
// This prevents race conditions and duplicate settings rows
model Settings {
  id                  String   @id @default("main")
  contactFee          Int      @default(50) @map("contact_fee")
  regularFee          Int      @default(30) @map("regular_fee")
  featuredFee         Int      @default(100) @map("featured_fee")
  premiumFee          Int      @default(200) @map("premium_fee")
  vipFee              Int      @default(300) @map("vip_fee")
  saleDisplayFee      Int      @default(100) @map("sale_display_fee")
  rentDisplayFee      Int      @default(75) @map("rent_display_fee")
  otherServicesFee    Int      @default(50) @map("other_services_fee")
  highlightFee        Int      @default(150) @map("highlight_fee")
  priorityListingFee  Int      @default(200) @map("priority_listing_fee")
  verifiedListingFee  Int      @default(250) @map("verified_listing_fee")
  currency            String   @default("ج.م")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@map("settings")
}

model OperationLog {
  id         String   @id @default(cuid())
  action     String   @map("action")
  entityType String?  @map("entity_type")
  entityId   String?  @map("entity_id")
  details    String?  @db.Text @map("details")
  userId     String?  @map("user_id")
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @db.Text @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("operation_logs")
}

model Session {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  token      String   @unique @map("token")
  expiresAt  DateTime @map("expires_at")
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @db.Text @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("sessions")
}

model SecurityLog {
  id         String   @id @default(cuid())
  action     String   @map("action")
  identifier String   @map("identifier")
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @db.Text @map("user_agent")
  details    String?  @db.Text @map("details")
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("security_logs")
}
